---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent';
import AffiliateConversionTracker from '../components/AffiliateConversionTracker';
import Analytics from '@vercel/analytics/astro';
import { FX_RATES } from '../lib/fx';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Cut your SaaS spend. Identify redundancies, downgrade plans without losing critical features, and migrate to cheaper alternatives with exact functional parity.",
  image = "/og-default.png",
  imageAlt = "StackCut — the audit desk for SaaS spend",
  canonicalURL,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://stackcut.app';
const resolvedCanonical = canonicalURL || new URL(Astro.url.pathname, siteUrl).href;
const resolvedImage = new URL(image, Astro.site || siteUrl).href;

// Site-wide Organization node so Google can attach a logo/brand entity.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "StackCut",
  "url": siteUrl,
  "logo": new URL("/icon-512.png", siteUrl).href,
  "description": "Independent audit desk for B2B SaaS spend. Manually-verified pricing data and free tools to cut software costs.",
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#f0f3ea" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="alternate" type="application/rss+xml" title="StackCut Blog" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="StackCut" />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="stylesheet" href="/print.css" media="print" />
    <script defer data-domain="stackcut.app" src="https://plausible.io/js/script.js"></script>
    <script>
      // Capture clicks on elements with data-plausible-event and send to Plausible
      document.addEventListener('click', function(e) {
        const target = e.target.closest('[data-plausible-event]');
        if (target && window.plausible) {
          var eventName = target.getAttribute('data-plausible-event');
          window.plausible(eventName);
        }
      });
    </script>
    <script is:inline define:vars={{ FX_RATES }}>
      (function() {
        const STORAGE_KEY = 'saas-downgrader-currency';
        // Rates injected at build from src/data/fx-rates.json (single source of
        // truth, refreshed by CI) — never hardcode them here.
        const EXCHANGE_RATES = FX_RATES;
        const CURRENCY_LOCALES = { USD: 'en-US', EUR: 'de-DE', GBP: 'en-GB' };

        function getStoredCurrency() {
          try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored === 'USD' || stored === 'EUR' || stored === 'GBP') {
              return stored;
            }
          } catch (e) {}
          return 'USD';
        }

        function updatePrices(currency) {
          const rate = EXCHANGE_RATES[currency] || 1;
          const locale = CURRENCY_LOCALES[currency] || 'en-US';
          
          document.querySelectorAll('[data-price-usd]').forEach(el => {
            const usdVal = parseFloat(el.getAttribute('data-price-usd'));
            if (isNaN(usdVal)) return;
            
            const period = el.getAttribute('data-price-period') || '';
            const converted = usdVal * rate;
            
            // If the value is 0, format it cleanly (e.g. Free/0)
            const formatted = new Intl.NumberFormat(locale, {
              style: 'currency',
              currency: currency,
              minimumFractionDigits: 0,
              maximumFractionDigits: usdVal % 1 === 0 ? 0 : 2
            }).format(converted);
            
            el.textContent = formatted + period;
          });

          // Sync selectors if they exist
          const selector = document.getElementById('global-currency-select');
          if (selector && selector.value !== currency) {
            selector.value = currency;
          }
          const selectorMobile = document.getElementById('global-currency-select-mobile');
          if (selectorMobile && selectorMobile.value !== currency) {
            selectorMobile.value = currency;
          }
        }

        // Initialize on page load
        function init() {
          const currency = getStoredCurrency();
          updatePrices(currency);
        }

        window.addEventListener('DOMContentLoaded', init);
        if (document.readyState === 'interactive' || document.readyState === 'complete') {
          init();
        }

        // Listen for changes
        window.addEventListener('currencyChange', function(e) {
          if (e.detail) {
            updatePrices(e.detail);
          }
        });
      })();
    </script>
    <script async src="https://media.ethicalads.io/media/client/ethicalads.min.js" onerror="console.info('EthicalAds blocked')"></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="jsonld" />
  </head>
  <body class="bg-grid min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-emerald-400 focus:text-zinc-950 focus:rounded focus:font-medium focus:ring-2 focus:ring-emerald-500">
      Skip to content
    </a>
    {/* Ledger margin: the red rule running down the page, like accounting paper */}
    <div class="fixed inset-y-0 left-4 sm:left-8 lg:left-12 w-px bg-red-400/30 pointer-events-none z-0" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
    <CookieConsent client:load />
    <AffiliateConversionTracker client:load />
    <Analytics />
    <script>
      // Scroll-in reveals for [data-reveal] elements
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach(el => el.classList.add('revealed'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(el => observer.observe(el));
      }
    </script>
  </body>
</html>
