---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllProducts } from '../../lib/saas-data';
import { CATEGORY_ORDER } from '../../lib/categories';
import SchemaOrg from '../../components/SchemaOrg.astro';

const products = await getAllProducts();

const productsByCategory = CATEGORY_ORDER.map(category => ({
  category,
  products: products
    .filter(p => p.category === category)
    .sort((a, b) => {
      const aCheapest = a.plans.find(p => p.priceMonthly !== null && p.priceMonthly > 0);
      const bCheapest = b.plans.find(p => p.priceMonthly !== null && p.priceMonthly > 0);
      return (aCheapest?.priceMonthly || Infinity) - (bCheapest?.priceMonthly || Infinity);
    }),
})).filter(g => g.products.length > 0);
---

<Layout
  title="SaaS Pricing Guide 2026: All Plans Compared | StackCut"
  description="The complete SaaS pricing guide for 2026. Compare every plan across all major tools, see true costs, and find the cheapest option that fits your team's needs."
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Pricing' }]} />
  
  <main id="main-content" role="main" class="flex-1">
    <section class="section-padding pt-20 pb-8">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">
            SaaS <span class="text-emerald-400">Pricing Guide</span> 2026
          </h1>
          <p class="text-zinc-400 max-w-3xl text-lg">
            Complete pricing breakdown for every major SaaS tool. See all plans, compare features, and find the cheapest option that covers your needs.
          </p>
        </div>

        {productsByCategory.map(({ category, products }) => (
          <div class="mb-12">
            <h2 class="text-xl font-bold text-zinc-100 mb-4">{category}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {products.map(product => {
                const cheapest = product.plans.find(p => p.priceMonthly !== null && p.priceMonthly > 0);
                return (
                  <a href={`/pricing/${product.slug}`} class="card-blur rounded-lg p-5 hover:border-emerald-400/30 transition-all group">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-zinc-100 font-semibold group-hover:text-emerald-400 transition-colors">{product.name}</span>
                      <span class="text-xs text-zinc-500">{product.plans.length} plans</span>
                    </div>
                    <div class="flex items-baseline gap-2 mb-2">
                      {cheapest ? (
                        <span class="text-lg font-bold text-emerald-400" data-price-usd={cheapest.priceMonthly} data-price-period="/mo">${cheapest.priceMonthly}/mo</span>
                      ) : (
                        <span class="text-lg font-bold text-zinc-500">Custom</span>
                      )}
                      <span class="text-xs text-zinc-500">starting price</span>
                    </div>
                    <p class="text-xs text-zinc-500 line-clamp-2">{product.description}</p>
                  </a>
                );
              })}
            </div>
          </div>
        ))}

        <div class="mt-16 max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-zinc-100 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Why do SaaS prices vary so much between plans?</h3>
              <p class="text-zinc-400 text-sm">Most SaaS vendors use feature gating to push customers toward higher tiers. Common triggers include seat counts, storage limits, automation workflows, and enterprise-only features like SSO or audit logs.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Is annual billing always cheaper than monthly?</h3>
              <p class="text-zinc-400 text-sm">Annual plans typically save 15–20% compared to monthly, but they also lock you in. StackCut shows both pricing options where available so you can weigh the discount against the commitment risk.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">What is the most effective way to reduce SaaS spend?</h3>
              <p class="text-zinc-400 text-sm">Audit which features you actually use, then compare your current plan against lower tiers or competing tools that cover only those features. Most teams pay for at least one tier above what they need.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Does StackCut track free SaaS tiers too?</h3>
              <p class="text-zinc-400 text-sm">Yes. Free plans are included in every pricing breakdown. If a tool offers a genuine free tier, it appears at the top of the plan list so you can evaluate it before committing to a paid option.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<SchemaOrg
  type="FAQPage"
  faqItems={[
    { question: "Why do SaaS prices vary so much between plans?", answer: "Most SaaS vendors use feature gating to push customers toward higher tiers. Common triggers include seat counts, storage limits, automation workflows, and enterprise-only features like SSO or audit logs." },
    { question: "Is annual billing always cheaper than monthly?", answer: "Annual plans typically save 15–20% compared to monthly, but they also lock you in. StackCut shows both pricing options where available so you can weigh the discount against the commitment risk." },
    { question: "What is the most effective way to reduce SaaS spend?", answer: "Audit which features you actually use, then compare your current plan against lower tiers or competing tools that cover only those features. Most teams pay for at least one tier above what they need." },
    { question: "Does StackCut track free SaaS tiers too?", answer: "Yes. Free plans are included in every pricing breakdown. If a tool offers a genuine free tier, it appears at the top of the plan list so you can evaluate it before committing to a paid option." },
  ]}
/>