---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure';
import SchemaOrg from '../components/SchemaOrg.astro';
import NegotiationScriptGenerator from '../components/NegotiationScriptGenerator';
import { getAllProducts } from '../lib/saas-data';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const allProducts = await getAllProducts();
---

<Layout 
  title="AI Negotiation Scripts | StackCut"
  description="Generate hyper-persuasive negotiation and cancellation emails based on real competitor pricing data. Copy, paste, and save thousands."
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Negotiation Scripts' }]} />
  <AffiliateDisclosure client:load />
  
  <main id="main-content" role="main" class="flex-1">
    <section class="section-padding pt-20 pb-8">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-400/20 bg-emerald-400/5 text-emerald-400 text-xs font-medium mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Module 03 — Negotiation Script Generator
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">Negotiation Scripts</h1>
          <p class="text-zinc-400 max-w-2xl mx-auto">
            Your SaaS vendor fears churn more than discounts. Generate a data-driven negotiation email 
            that leverages real competitor pricing to force their hand.
          </p>
        </div>
        
        <NegotiationScriptGenerator client:visible products={allProducts} />

        <div class="mt-16 max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-zinc-100 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Do negotiation scripts actually work?</h3>
              <p class="text-zinc-400 text-sm">Yes. Account Executives are typically authorized to offer 15-30% discounts to prevent churn, but they only do so if you present credible alternatives and show intent to leave. Data-driven emails force this conversation.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">When is the best time to negotiate?</h3>
              <p class="text-zinc-400 text-sm">The highest leverage point is 30-60 days before your contract renewal. This gives you enough time to realistically evaluate alternatives, making your threat to migrate highly credible to the vendor.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<SchemaOrg 
  type="WebApplication"
  toolTitle="AI Negotiation Scripts"
  toolDescription="Generate hyper-persuasive negotiation and cancellation emails based on real competitor pricing data. Copy, paste, and save thousands."
/>

<SchemaOrg 
  type="FAQPage"
  faqItems={[
    { question: "Do negotiation scripts actually work?", answer: "Yes. Account Executives are typically authorized to offer 15-30% discounts to prevent churn, but they only do so if you present credible alternatives and show intent to leave. Data-driven emails force this conversation." },
    { question: "When is the best time to negotiate?", answer: "The highest leverage point is 30-60 days before your contract renewal. This gives you enough time to realistically evaluate alternatives, making your threat to migrate highly credible to the vendor." }
  ]}
/>
