---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORY_ORDER } from '../../lib/categories';
import { getAllProducts } from '../../lib/saas-data';
import SchemaOrg from '../../components/SchemaOrg.astro';

const products = await getAllProducts();

const categoryData = CATEGORY_ORDER.map(category => {
  const categoryProducts = products.filter(p => p.category === category);
  const categorySlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return {
    name: category,
    slug: categorySlug,
    count: categoryProducts.length,
    cheapest: categoryProducts.reduce((min, p) => {
      const pCheapest = p.plans.find(pl => pl.priceMonthly !== null && pl.priceMonthly > 0);
      if (!pCheapest) return min;
      return min === null || (pCheapest.priceMonthly || Infinity) < min ? pCheapest.priceMonthly : min;
    }, null as number | null),
  };
});
---

<Layout
  title="Best SaaS Software by Category in 2026 | StackCut"
  description="Find the best SaaS software in every category. Compare exact pricing, features, and discover cheaper alternatives that deliver the same functionality for less."
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Best Tools' }]} />
  
  <main id="main-content" role="main" class="flex-1">
    <section class="section-padding pt-20 pb-8">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">
            Best <span class="text-emerald-400">SaaS Tools</span> in 2026
          </h1>
          <p class="text-zinc-400 max-w-3xl text-lg">
            Compare the best SaaS tools by category. See exact pricing, features, and find cheaper alternatives with the same functionality.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {categoryData.map(cat => (
            <a href={`/best/${cat.slug}`} class="card-blur rounded-xl p-6 hover:border-emerald-400/30 transition-all group">
              <h2 class="text-lg font-bold text-zinc-100 mb-2 group-hover:text-emerald-400 transition-colors">
                Best {cat.name} Tools
              </h2>
              <p class="text-zinc-500 text-sm mb-4">
                {cat.count} tools compared
              </p>
              <div class="flex items-center justify-between">
                {cat.cheapest !== null ? (
                  <span class="text-emerald-400 font-mono text-sm" data-price-usd={cat.cheapest} data-price-period="/mo">
                    From ${cat.cheapest}/mo
                  </span>
                ) : (
                  <span class="text-zinc-500 text-sm">Custom pricing</span>
                )}
                <span class="text-xs text-zinc-500 group-hover:text-emerald-400 transition-colors">
                  View all →
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-16 max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-zinc-100 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Which SaaS category should I look at first to reduce costs?</h3>
              <p class="text-zinc-400 text-sm">Start with your highest per-seat tools — CRM, project management, and customer support are typically the biggest budget lines. StackCut shows the cheapest starting price in each category so you can prioritize quickly.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">How do I know if a cheaper tool covers all the features I need?</h3>
              <p class="text-zinc-400 text-sm">Each category page lists feature tags for every tool. Click through to a specific product's alternatives page to see a feature-for-feature comparison that highlights any gaps between your current tool and a cheaper option.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Do free SaaS plans work for growing businesses?</h3>
              <p class="text-zinc-400 text-sm">Many free tiers are viable for teams under 10 people, but they often restrict storage, automation, or advanced integrations. StackCut flags which tools have a meaningful free tier so you can test before committing.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">How often do SaaS tool prices change?</h3>
              <p class="text-zinc-400 text-sm">Pricing changes more often than most people realize — vendors quietly raise prices, add per-feature charges, or drop free tiers. StackCut re-verifies pricing weekly and shows a freshness badge on every page.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<SchemaOrg
  type="FAQPage"
  faqItems={[
    { question: "Which SaaS category should I look at first to reduce costs?", answer: "Start with your highest per-seat tools — CRM, project management, and customer support are typically the biggest budget lines. StackCut shows the cheapest starting price in each category so you can prioritize quickly." },
    { question: "How do I know if a cheaper tool covers all the features I need?", answer: "Each category page lists feature tags for every tool. Click through to a specific product's alternatives page to see a feature-for-feature comparison that highlights any gaps between your current tool and a cheaper option." },
    { question: "Do free SaaS plans work for growing businesses?", answer: "Many free tiers are viable for teams under 10 people, but they often restrict storage, automation, or advanced integrations. StackCut flags which tools have a meaningful free tier so you can test before committing." },
    { question: "How often do SaaS tool prices change?", answer: "Pricing changes more often than most people realize — vendors quietly raise prices, add per-feature charges, or drop free tiers. StackCut re-verifies pricing weekly and shows a freshness badge on every page." },
