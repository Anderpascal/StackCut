---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout 
  title="Blog | StackCut"
  description="Data-driven guides on SaaS cost optimization, negotiation tactics, open source alternatives, and stack auditing for engineering leaders."
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
  <main id="main-content" role="main" class="flex-1">
    <section class="section-padding pt-20 pb-8">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">Blog</h1>
          <p class="text-zinc-400 max-w-2xl mx-auto">
            Data-driven guides on SaaS cost optimization, negotiation tactics, open source alternatives, and stack auditing for engineering leaders.
          </p>
        </div>

        {posts.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-zinc-500">No posts yet. Check back soon.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map(post => {
              const { title, description, pubDate, tags, category } = post.data;
              return (
                <a href={`/blog/${post.id}`} class="card-blur rounded-xl p-6 hover:border-emerald-400/30 transition-all group">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-[10px] text-emerald-400 border border-emerald-400/20 rounded px-1.5 py-0.5 uppercase">
                      {category}
                    </span>
                  </div>
                  <h2 class="text-lg font-bold text-zinc-100 mb-2 group-hover:text-emerald-400 transition-colors">
                    {title}
                  </h2>
                  <p class="text-zinc-400 text-sm mb-4 line-clamp-3 leading-relaxed">
                    {description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-3">
                    {tags.map(tag => (
                      <span class="text-xs text-zinc-500 bg-zinc-900 border border-zinc-800 rounded px-2 py-0.5">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <div class="text-xs text-zinc-500">
                    {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
