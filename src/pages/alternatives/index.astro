---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import EmailCapture from '../../components/EmailCapture';
import { getAllProducts } from '../../lib/saas-data';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';

const allProducts = await getAllProducts();
---

<Layout
  title="Cheap SaaS Alternatives to Every Major Tool | StackCut"
  description="Browse verified cheap alternatives to every major SaaS tool. Our pricing agents map exact feature parity so you never overpay for software you barely use."
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'All Alternatives' }]} />
  <main id="main-content" role="main" class="flex-1">
    <section class="section-padding pt-20 pb-8">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">All SaaS Alternatives</h1>
          <p class="text-zinc-400 max-w-2xl mx-auto">
            Every alternative page is auto-generated by our pricing agents. Select a tool to see exact downgrade paths and cheaper competitors.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {allProducts.map(product => {
            const cheapest = product.plans.filter(p => p.priceMonthly !== null && p.priceMonthly > 0).sort((a, b) => (a.priceMonthly || 0) - (b.priceMonthly || 0))[0];
            return (
              <a href={`/alternatives/${product.slug}-cheap`} class="card-blur rounded-xl p-5 hover:border-emerald-400/30 transition-all group">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-semibold text-zinc-100">{product.name}</span>
                  <span class="text-xs text-zinc-500 border border-zinc-800 rounded px-2 py-0.5">{product.category}</span>
                </div>
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-xl font-bold text-emerald-400">${cheapest?.priceMonthly || 0}</span>
                  <span class="text-zinc-500 text-xs">/mo entry</span>
                </div>
                <div class="text-xs text-zinc-500 group-hover:text-emerald-400 transition-colors">
                  View alternatives &rarr;
                </div>
              </a>
            );
          })}
        </div>

        <div class="mt-12 max-w-xs mx-auto">
          <div class="card-blur rounded-xl p-6">
            <EmailCapture client:load variant="sidebar" headline="Get weekly SaaS savings tips" />
          </div>
        </div>

        <div class="mt-16 max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-zinc-100 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">What are SaaS alternatives?</h3>
              <p class="text-zinc-400 text-sm">SaaS alternatives are competing tools in the same category that offer similar or identical features at a lower price. StackCut maps feature parity so you know exactly what you gain or lose when switching.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">How does StackCut find cheaper SaaS alternatives?</h3>
              <p class="text-zinc-400 text-sm">Autonomous pricing agents continuously crawl vendor pricing pages and match features across tools in the same category. Every alternative is ranked by how closely it mirrors the original tool's capabilities.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Can I switch tools without losing key features?</h3>
              <p class="text-zinc-400 text-sm">In most cases, yes. StackCut highlights feature-for-feature parity so you can see exactly which capabilities carry over. Any gaps — especially for niche enterprise features — are flagged before you commit.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">How often is the alternatives data updated?</h3>
              <p class="text-zinc-400 text-sm">Pricing and feature data is re-verified on a rolling basis, typically every week or when a vendor announces a change. Each page shows a freshness badge so you always know how current the data is.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<SchemaOrg
  type="FAQPage"
  faqItems={[
    { question: "What are SaaS alternatives?", answer: "SaaS alternatives are competing tools in the same category that offer similar or identical features at a lower price. StackCut maps feature parity so you know exactly what you gain or lose when switching." },
    { question: "How does StackCut find cheaper SaaS alternatives?", answer: "Autonomous pricing agents continuously crawl vendor pricing pages and match features across tools in the same category. Every alternative is ranked by how closely it mirrors the original tool's capabilities." },
    { question: "Can I switch tools without losing key features?", answer: "In most cases, yes. StackCut highlights feature-for-feature parity so you can see exactly which capabilities carry over. Any gaps — especially for niche enterprise features — are flagged before you commit." },
    { question: "How often is the alternatives data updated?", answer: "Pricing and feature data is re-verified on a rolling basis, typically every week or when a vendor announces a change. Each page shows a freshness badge so you always know how current the data is." },
  ]}
/>
