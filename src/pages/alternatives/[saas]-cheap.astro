---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure';
import AffiliateLink from '../../components/AffiliateLink';
import { getAllProducts, getAlternatives } from '../../lib/saas-data';
import { getMonetizedUrl } from '../../lib/affiliates';
import FreshnessBadge from '../../components/FreshnessBadge.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const products = await getAllProducts();
  const paths = [];
  for (const product of products) {
    const alternatives = await getAlternatives(product);
    paths.push({
      params: { saas: product.slug },
      props: { product, alternatives },
    });
  }
  return paths;
};

const { product, alternatives } = Astro.props;
const cheapestPlan = product.plans
  .filter(p => p.priceMonthly !== null && p.priceMonthly > 0)
  .sort((a, b) => (a.priceMonthly || 0) - (b.priceMonthly || 0))[0];
const enterprisePlan = product.plans.find(p => p.isEnterprise);
---

<Layout 
  title={`Best Cheap ${product.name} Alternatives in 2026 | StackCut`}
  description={`Discover cheaper alternatives to ${product.name} with exact feature parity. Save up to $${(enterprisePlan && cheapestPlan ? (enterprisePlan.priceAnnually ?? (enterprisePlan.priceMonthly || 0) * 12) - (cheapestPlan.priceAnnually ?? (cheapestPlan.priceMonthly || 0) * 12) : 0).toLocaleString()}/year by switching tools without losing functionality.`}
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Alternatives', href: '/alternatives' }, { label: product.name }]} />
  <AffiliateDisclosure client:load />
  
  <main id="main-content" role="main" class="flex-1">
    <section class="section-padding pt-20 pb-8">
      <div class="max-w-5xl mx-auto">
        <div class="mb-12">
          <FreshnessBadge date={product.lastVerified} showCaveat class="mb-6" />
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-100 mb-4">
            Cheap <span class="text-emerald-400">{product.name}</span> Alternatives
          </h1>
          <p class="text-zinc-400 max-w-2xl text-lg">
            {product.description} Stop overpaying. Every alternative below is mapped feature-by-feature against the same verified pricing dataset, so the parity comparison is like-for-like.
          </p>
        </div>

        {/* Pricing Overview */}
        <div class="card-blur rounded-xl p-6 mb-12">
          <h2 class="text-lg font-semibold text-zinc-100 mb-4">{product.name} Pricing Overview</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-zinc-800">
                  <th class="text-left py-3 px-4 text-zinc-500 font-medium">Plan</th>
                  <th class="text-left py-3 px-4 text-zinc-500 font-medium">Price/mo</th>
                  <th class="text-left py-3 px-4 text-zinc-500 font-medium">Price/yr</th>
                  <th class="text-left py-3 px-4 text-zinc-500 font-medium">Type</th>
                </tr>
              </thead>
              <tbody>
                {product.plans.map(plan => (
                  <tr class="border-b border-zinc-800/50 hover:bg-zinc-900/30 transition-colors">
                    <td class="py-3 px-4 text-zinc-200 font-medium">{plan.name}</td>
                    <td class="py-3 px-4 text-zinc-300">
                      {plan.priceMonthly !== null ? (
                        <span data-price-usd={plan.priceMonthly} data-price-period="/mo">${plan.priceMonthly}/mo</span>
                      ) : (
                        'Custom'
                      )}
                    </td>
                    <td class="py-3 px-4 text-zinc-300">
                      {plan.priceAnnually !== null ? (
                        <span data-price-usd={plan.priceAnnually} data-price-period="/yr">${plan.priceAnnually.toLocaleString()}/yr</span>
                      ) : (
                        'Custom'
                      )}
                    </td>
                    <td class="py-3 px-4">
                      {plan.isEnterprise ? (
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-400/10 text-red-400 border border-red-400/20">Enterprise</span>
                      ) : (
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-800 text-zinc-400">Standard</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Alternatives */}
        <h2 class="text-2xl font-bold text-zinc-100 mb-6">Top {product.name} Alternatives</h2>
        
        {alternatives.length > 0 ? (
          <div class="space-y-6">
            {alternatives.map((alt, idx) => {
              const altCheapest = alt.plans.filter(p => p.priceMonthly !== null && p.priceMonthly > 0).sort((a, b) => (a.priceMonthly || 0) - (b.priceMonthly || 0))[0];
              const currentPrice = product.plans.filter(p => p.priceMonthly !== null && p.priceMonthly > 0).sort((a, b) => (b.priceMonthly || 0) - (a.priceMonthly || 0))[0];
              const savings = currentPrice && altCheapest ? (currentPrice.priceAnnually ?? (currentPrice.priceMonthly || 0) * 12) - (altCheapest.priceAnnually ?? (altCheapest.priceMonthly || 0) * 12) : 0;
              
              return (
                <div class="card-blur rounded-xl p-6 sm:p-8 border-l-2 border-l-emerald-400">
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
                    <div>
                      <div class="flex items-center gap-3 mb-2">
                        <span class="text-xl font-bold text-zinc-100">{alt.name}</span>
                        <span class="text-xs text-zinc-500 border border-zinc-800 rounded px-2 py-0.5">{alt.category}</span>
                      </div>
                      <p class="text-zinc-400 text-sm max-w-xl">{alt.description}</p>
                    </div>
                    <div class="text-right shrink-0">
                      <div class="text-2xl font-bold text-emerald-400">
                        {altCheapest?.priceMonthly !== null && altCheapest?.priceMonthly !== undefined ? (
                          <span data-price-usd={altCheapest.priceMonthly} data-price-period="/mo">${altCheapest.priceMonthly}/mo</span>
                        ) : (
                          'Custom'
                        )}
                      </div>
                      {savings > 0 && (
                        <div class="text-sm text-emerald-400/80">
                          Save <span data-price-usd={savings} data-price-period="/yr">${savings.toLocaleString()}/yr</span>
                        </div>
                      )}
                    </div>
                  </div>
                  
                  <div class="flex flex-wrap gap-2 mb-6">
                    {(alt.featureIds || []).slice(0, 6).map((fid: string) => (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs">
                        {fid.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
                      </span>
                    ))}
                  </div>
                  
                  <div class="flex items-center gap-4 pt-4 border-t border-zinc-800">
                    <a 
                      href={`/compare/${product.slug}-vs-${alt.slug}-costs`}
                      class="text-sm text-zinc-400 hover:text-emerald-400 transition-colors focus:ring-2 focus:ring-emerald-500 focus:outline-none rounded"
                    >
                      Full comparison &rarr;
                    </a>
                    <AffiliateLink client:load href={getMonetizedUrl(alt)} productId={alt.id} variant="button" class="ml-auto">
                      View Alternative
                    </AffiliateLink>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="card-blur rounded-xl p-12 text-center">
            <p class="text-zinc-500">No direct alternatives indexed yet in this category. Check back as the dataset grows.</p>
          </div>
        )}

        {/* Downgrade CTA */}
        <div class="mt-12 card-blur rounded-xl p-8 border border-emerald-400/10 bg-emerald-400/5">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
            <div>
              <h3 class="text-lg font-bold text-zinc-100 mb-1">Not ready to switch?</h3>
              <p class="text-zinc-400 text-sm">See if you can downgrade your current {product.name} plan first.</p>
            </div>
            <a href={`/downgrade`} class="btn-primary shrink-0">
              Analyze {product.name} Downgrade
            </a>
          </div>
        </div>

        <div class="mt-16 max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-zinc-100 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">What is the cheapest {product.name} alternative?</h3>
              <p class="text-zinc-400 text-sm">The cheapest alternative depends on which {product.name} features you actively use. StackCut ranks alternatives by starting price and highlights any feature gaps so you can find the lowest-cost option without losing the workflows you rely on.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Do {product.name} alternatives offer the same features?</h3>
              <p class="text-zinc-400 text-sm">Most alternatives in the same category share 70–90% of core features. StackCut maps shared feature IDs to show exactly which capabilities carry over and flags any gaps — especially enterprise-only features like SSO or advanced reporting.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">How much can I save by switching from {product.name}?</h3>
              <p class="text-zinc-400 text-sm">Savings depend on your current plan and the alternative you choose. Each alternative card on this page shows an estimated annual saving based on verified pricing data, so you can compare options at a glance.</p>
            </div>
            <div class="card-blur rounded-xl p-6">
              <h3 class="text-lg font-medium text-zinc-100 mb-2">Is it difficult to migrate away from {product.name}?</h3>
              <p class="text-zinc-400 text-sm">Migration complexity varies by tool, but most modern SaaS products support CSV export or direct integration with common alternatives. StackCut links to each alternative's site so you can check their import guides before committing.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<SchemaOrg
  type="ItemList"
  listName={`${product.name} Alternatives`}
  items={[
    { name: product.name, position: 1 },
    ...alternatives.map((alt, i) => ({ name: alt.name, position: i + 2 })),
  ]}
/>

<SchemaOrg
  type="FAQPage"
  faqItems={[
    { question: `What is the cheapest ${product.name} alternative?`, answer: `The cheapest alternative depends on which ${product.name} features you actively use. StackCut ranks alternatives by starting price and highlights any feature gaps so you can find the lowest-cost option without losing the workflows you rely on.` },
    { question: `Do ${product.name} alternatives offer the same features?`, answer: `Most alternatives in the same category share 70–90% of core features. StackCut maps shared feature IDs to show exactly which capabilities carry over and flags any gaps — especially enterprise-only features like SSO or advanced reporting.` },
    { question: `How much can I save by switching from ${product.name}?`, answer: `Savings depend on your current plan and the alternative you choose. Each alternative card on this page shows an estimated annual saving based on verified pricing data, so you can compare options at a glance.` },
    { question: `Is it difficult to migrate away from ${product.name}?`, answer: `Migration complexity varies by tool, but most modern SaaS products support CSV export or direct integration with common alternatives. StackCut links to each alternative's site so you can check their import guides before committing.` },
  ]}
/>
