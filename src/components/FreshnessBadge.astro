---
import { getFreshness, FRESHNESS_CLASSES } from '../lib/freshness';

interface Props {
  /** ISO YYYY-MM-DD date the data was last verified. */
  date: string | null | undefined;
  /** Show the longer caveat text under the badge for aging/stale data. */
  showCaveat?: boolean;
  class?: string;
}

const { date, showCaveat = false, class: className = '' } = Astro.props;
const f = getFreshness(date);
const c = FRESHNESS_CLASSES[f.level];
---

<span class:list={["inline-flex flex-col gap-1", className]}>
  <span
    class:list={[
      'inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-medium num',
      c.ring,
      c.text,
    ]}
    title={f.caveat ?? f.label}
  >
    <span class:list={['w-1.5 h-1.5 rounded-full', c.dot]} aria-hidden="true"></span>
    {f.label}
  </span>
  {showCaveat && f.caveat && (
    <span class:list={['text-xs max-w-xs', c.text]}>{f.caveat}</span>
  )}
</span>
