---
import { safeJsonLd } from '../lib/jsonld';
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const siteUrl = 'https://stackcut.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.label,
    ...(item.href ? { "item": new URL(item.href, siteUrl).href } : {})
  }))
};
---

<nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-2">
  <ol class="flex items-center gap-1.5 text-xs text-zinc-500 flex-wrap">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && (
          <svg class="w-3 h-3 text-zinc-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {item.href && i < items.length - 1 ? (
          <a href={item.href} class="hover:text-emerald-400 transition-colors">{item.label}</a>
        ) : (
          <span class="text-zinc-400">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />
