---
const links = [
  { href: '/downgrade', label: 'Downgrade Engine' },
  { href: '/enterprise-tax', label: 'Enterprise Tax' },
  { href: '/negotiation', label: 'Negotiate' },
  { href: '/audit', label: 'Stack Audit' },
  { href: '/monitor', label: 'Monitor' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];

const mobileLinks = [
  { href: '/downgrade', label: 'Downgrade Engine' },
  { href: '/enterprise-tax', label: 'Enterprise Tax' },
  { href: '/negotiation', label: 'Negotiation Scripts' },
  { href: '/audit', label: 'Stack Audit' },
  { href: '/monitor', label: 'Stack Monitor' },
  { href: '/roi', label: 'ROI Calculator' },
  { href: '/tools', label: 'All Tools' },
  { href: '/alternatives', label: 'All Alternatives' },
  { href: '/compare', label: 'Comparisons' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<nav class="sticky top-0 z-50 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur-xl" role="navigation" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-baseline gap-0.5 group focus:outline-none rounded" aria-label="StackCut home">
        <span class="font-display font-extrabold text-xl tracking-tight text-zinc-100 select-none"><span
          class="logo-letter" style="--i:0">S</span><span
          class="logo-letter" style="--i:1">t</span><span
          class="logo-letter" style="--i:2">a</span><span
          class="logo-letter" style="--i:3">c</span><span
          class="logo-letter" style="--i:4">k</span><span class="relative inline-block text-emerald-400"><span
            class="logo-letter" style="--i:5">C</span><span
            class="logo-letter" style="--i:6">u</span><span
            class="logo-letter" style="--i:7">t</span><span class="logo-strike" aria-hidden="true"></span></span></span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-2">
        {links.map(link => (
          <a href={link.href} class="nav-link px-2 py-2 text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors focus:outline-none rounded">
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <!-- Global Currency Selector -->
        <div class="relative flex items-center">
          <select
            id="global-currency-select"
            class="bg-zinc-950 border border-zinc-800 rounded-md px-2 py-1 text-xs num text-zinc-400 focus:outline-none focus:border-emerald-400 transition-all cursor-pointer mr-2"
            aria-label="Select global currency"
          >
            <option value="USD">USD ($)</option>
            <option value="EUR">EUR (€)</option>
            <option value="GBP">GBP (£)</option>
          </select>
        </div>

        <a href="/downgrade" class="btn-primary text-sm py-2 px-4 hidden sm:inline-flex focus:outline-none">
          Start an audit
        </a>

        <!-- Mobile hamburger toggle (checkbox hack) -->
        <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" aria-hidden="true" />
        <label
          for="mobile-menu-toggle"
          class="md:hidden cursor-pointer p-2 rounded-md hover:bg-zinc-900 transition-colors focus:outline-none"
          aria-label="Toggle navigation menu"
          role="button"
          aria-controls="mobile-menu"
          tabindex="0"
        >
          <svg class="w-6 h-6 text-zinc-300 peer-checked:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 text-zinc-300 hidden peer-checked:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </label>

        <!-- Mobile drawer -->
        <div id="mobile-menu" class="hidden peer-checked:block absolute top-16 left-0 right-0 bg-zinc-950/95 backdrop-blur-xl border-b border-zinc-800 shadow-lg md:hidden" role="navigation" aria-label="Mobile navigation">
          <div class="px-4 py-4 space-y-1">
            {mobileLinks.map(link => (
              <a href={link.href} class="block px-4 py-3 rounded-md text-sm font-medium text-zinc-300 hover:text-emerald-400 hover:bg-zinc-900 transition-all focus:outline-none">
                {link.label}
              </a>
            ))}
            <div class="pt-4 border-t border-zinc-800 px-4 flex items-center justify-between">
              <span class="text-xs text-zinc-400">Currency</span>
              <select
                id="global-currency-select-mobile"
                class="bg-zinc-950 border border-zinc-800 rounded-md px-2 py-1 text-xs num text-zinc-400 focus:outline-none focus:border-emerald-400 transition-all cursor-pointer"
                aria-label="Select global currency mobile"
              >
                <option value="USD">USD ($)</option>
                <option value="EUR">EUR (€)</option>
                <option value="GBP">GBP (£)</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Individual logo letters */
  .logo-letter {
    display: inline-block;
    will-change: transform;
  }

  @keyframes logoWave {
    0%   { transform: translateY(0)    rotate(0deg);    }
    38%  { transform: translateY(-9px) rotate(-2deg);   }
    62%  { transform: translateY(-4px) rotate(0.8deg);  }
    100% { transform: translateY(0)    rotate(0deg);    }
  }

  .group:hover .logo-letter {
    animation: logoWave 0.52s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 48ms) both;
  }

  /* The brand mark: "Cut" carries a permanent red pen strike */
  .logo-strike {
    position: absolute;
    left: -4%;
    right: -6%;
    top: 56%;
    height: 0.09em;
    min-height: 2.5px;
    border-radius: 99px;
    background: var(--color-pen);
    transform: translateY(-50%) rotate(-3deg);
    transform-origin: left center;
    pointer-events: none;
  }

  @keyframes strikeSlash {
    0%   { transform: translateY(-50%) rotate(-3deg) scaleX(1); opacity: 1;   }
    28%  { transform: translateY(-50%) rotate(-3deg) scaleX(0); opacity: 0.2; }
    100% { transform: translateY(-50%) rotate(-3deg) scaleX(1); opacity: 1;   }
  }

  .group:hover .logo-strike {
    animation: strikeSlash 0.48s cubic-bezier(0.4, 0, 0.2, 1) 0.22s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .group:hover .logo-letter  { animation: none; }
    .group:hover .logo-strike  { animation: none; }
  }

  /* Nav links: red underline draws in from the left */
  .nav-link {
    background-image: linear-gradient(var(--color-pen), var(--color-pen));
    background-repeat: no-repeat;
    background-position: 0.5rem calc(100% - 0.35rem);
    background-size: 0 2px;
    transition: background-size 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background-size: calc(100% - 1rem) 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link { transition: none; }
  }
</style>

<script>
  // Mobile menu links toggle handler
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      const toggle = document.getElementById('mobile-menu-toggle');
      if (toggle) toggle.checked = false;
    });
  });

  // Global Currency Selectors logic
  const STORAGE_KEY = 'saas-downgrader-currency';

  function setCurrency(c) {
    try {
      localStorage.setItem(STORAGE_KEY, c);
    } catch(e) {}
    window.dispatchEvent(new CustomEvent('currencyChange', { detail: c }));
  }

  const select = document.getElementById('global-currency-select');
  select?.addEventListener('change', (e) => {
    setCurrency(e.target.value);
  });

  const selectMobile = document.getElementById('global-currency-select-mobile');
  selectMobile?.addEventListener('change', (e) => {
    setCurrency(e.target.value);
  });

  // Initial Sync from LocalStorage
  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'USD' || stored === 'EUR' || stored === 'GBP') {
      if (select) select.value = stored;
      if (selectMobile) selectMobile.value = stored;
    }
  } catch(e) {}
</script>
