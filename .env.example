# ── Newsletter (Buttondown) ────────────────────────────────────────────────
# Required for /api/subscribe to forward opt-ins.
# Get your API key at: https://buttondown.email/settings/integrations
BUTTONDOWN_API_KEY=your_buttondown_api_key_here

# ── Subscribe endpoint hardening ───────────────────────────────────────────
# Canonical site origin used to reject cross-site POSTs to /api/subscribe.
PUBLIC_SITE_ORIGIN=https://stackcut.app

# Durable rate limiting (optional but recommended in production). Without these
# the endpoint falls back to a best-effort in-memory limiter per serverless
# instance. Create a free database at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Data freshness pipeline (CI only) ──────────────────────────────────────
# Firecrawl key used by scripts/scrape-pricing.mjs to re-scrape vendor pricing.
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# Live FX rates at build time (optional). Without it, build falls back to the
# last committed rates in src/data/fx-rates.json. Any provider returning
# { rates: { EUR: number, GBP: number } } against a USD base works.
# Example: https://open.er-api.com/v6/latest/USD (no key needed)
FX_RATES_URL=https://open.er-api.com/v6/latest/USD
